{
  "expo": {
    "name": "Nuzzle",
    "slug": "nuzzle",
    "scheme": "nuzzle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1A1221",
    "ios": {
      "bundleIdentifier": "com.philipnader.nuzzle",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "9QLBWXC74X"
    },
    "android": {
      "package": "com.philipnader.nuzzle",
      "adaptiveIcon": {
        "backgroundColor": "#1A1221",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#EBA3B9"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.quickquotegroup.nuzzle",
          "widgets": [
            {
              "name": "NuzzleWidget",
              "displayName": "Nuzzle",
              "description": "Time since the last feed, the side to start on, and a running feed's timer.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/NuzzleWidget.tsx",
                "configuration": {
                  "title": "Choose a baby",
                  "description": "Which baby this widget shows.",
                  "parameters": {
                    "baby": {
                      "title": "Baby",
                      "type": "enum",
                      "dynamic": true,
                      "default": "active",
                      "values": [
                        {
                          "name": "Baby on screen",
                          "value": "active"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ],
          "bundleIdentifier": "com.philipnader.nuzzle.ExpoWidgetsTarget"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/with-nuzzle-intents"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
