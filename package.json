{
  "name": "nuzzle",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-widgets": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo/metro-runtime": "~58.0.15",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "preview:web": "expo export --platform web --output-dir dist && node scripts/serve-web.js",
    "shots": "node scripts/shots-web.js docs/screenshots/web",
    "check:dashes": "node scripts/check-dashes.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/node",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
